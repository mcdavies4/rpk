# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
# e.g. 123456789 (numbers only, no "properties/" prefix)

# Google Service Account credentials (JSON stringified)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# Simple password to protect the dashboard
DASHBOARD_PASSWORD=your_password_here
